todo CUDA_VISIBLE_DEVICES=2 python3 tools/test.py b_configs/dota/T_S_D_Res/paa101_dota.py /home/airstudio/code/2.12/work_dirs/paa101_dota/epoch_24.pth --eval bbox --out result.pkl
